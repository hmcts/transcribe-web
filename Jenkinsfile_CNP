#!groovy

@Library("Infrastructure@2.5.2")
import uk.gov.hmcts.contino.GithubAPI

def type = "nodejs"
def product = "transcribe"
def component = "web"

// Substituted into values.{aat,preview}.template.yaml for the Jenkins releases.
// Flux-deployed pods read it from the chart's keyVaults mount instead.
def secrets = [
  'transcribe-${env}': [
    secret('AppInsightsConnectionString', 'APP_INSIGHTS_CONNECTION_STRING'),
  ]
]

static LinkedHashMap<String, Object> secret(String secretName, String envVar) {
  [ $class: 'AzureKeyVaultSecret',
    secretType: 'Secret',
    name: secretName,
    version: '',
    envVariable: envVar
  ]
}

// The transcribe-api image a PR preview runs (values.preview.template.yaml): master's
// latest, or a transcribe-api PR's own image when this PR is labelled api-pr:<n>.
def apiImageTag() {
  for (label in new GithubAPI(this).getLabelsbyPattern(env.BRANCH_NAME, "api-pr:")) {
    def apiPr = label.minus("api-pr:").trim()
    if (!(apiPr ==~ /\d+/)) {
      error "Label '${label}': expected api-pr:<transcribe-api PR number>"
    }
    return "pr-${apiPr}"
  }
  return "latest"
}

// docs:
// 1. https://github.com/hmcts/cnp-jenkins-library
// 2. https://hmcts.github.io/ways-of-working/common-pipeline/common-pipeline.html#common-pipeline
withPipeline(type, product, component) {
  loadVaultSecrets(secrets)

  onPR {
    env.TRANSCRIBE_API_IMAGE_TAG = apiImageTag()
  }

  // AKS only. There is no App Service deployment for this product.
  disableLegacyDeployment()

  // The image's version (lib/app-version.ts). The pipeline's `az acr build` takes no
  // build arguments of ours, so the commit goes in as a file beside the source.
  before('dockerbuild') {
    writeFile file: 'BUILD_VERSION', text: env.GIT_COMMIT.substring(0, 7)
  }

  syncBranchesWithMaster(['demo', 'ithc', 'perftest'])
}
