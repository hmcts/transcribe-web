# Without this file `COPY . .` drags the whole working tree into the image.
# That is not just slow: next build picks up .env.local from the build context
# and bakes a developer's local values (API URLs, keys) into the bundle, which
# is exactly how a build ends up serving localhost URLs in a real environment.

# Local environment — must never reach a build
.env
.env.*
!.env.example

# Build and dependency output, rebuilt inside the image
node_modules
.next
out
tsconfig.tsbuildinfo

# VCS, CI and tooling
.git
.gitignore
.github
.claude
Dockerfile*
.dockerignore
docker-compose*.yml

# Tests and local-only assets
tests
playwright-report
test-results
coverage
*.log

# Charts and infra are deployed, not built into the image
charts
infrastructure

# Yarn local state (the image installs fresh)
.yarn
.pnp.*
