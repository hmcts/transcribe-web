# Local development image. The production image is Dockerfile; this one keeps
# the dev server and source mounts.
ARG REGISTRY_NAME=hmctsprod
FROM ${REGISTRY_NAME}.azurecr.io/base/node:24-alpine

USER root
RUN corepack enable

WORKDIR /app

COPY package.json yarn.lock .yarnrc.yml ./
RUN yarn install --immutable

COPY . .

EXPOSE 3000

CMD ["yarn", "dev"]
