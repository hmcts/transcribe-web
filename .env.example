# HMCTS Transcribe frontend — local configuration.
# Copy to .env.local for local development. Never commit .env.local.

# Backend base URL. transcribe-api serves both surfaces:
#   /api/*     dictation
#   /api/v1/*  recording
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
BACKEND_INTERNAL_URL=http://127.0.0.1:8000

# Recording area used to be deployed under a /batch basePath as its own app.
# In the merged app it is a route group at /recording, so no basePath is needed.
NEXT_PUBLIC_BASE_PATH=

# Machine key for the recording service's non-user-facing ingress. Not needed
# for normal local browsing.
TRANSCRIPTION_API_KEY=

# Edge auth gate. Unset or "false" leaves /recording and /admin open locally.
# Terraform sets this true on stg/prod. See proxy.ts.
EASY_AUTH_ENABLED=false
