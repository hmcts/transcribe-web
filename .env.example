# HMCTS Transcribe frontend — local configuration.
# Copy to .env.local for local development. Never commit .env.local.

# Backend base URL. transcribe-api serves both surfaces:
#   /api/*     dictation
#   /api/v1/*  recording
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
BACKEND_INTERNAL_URL=http://127.0.0.1:8000

# Recording area used to be deployed under a /batch basePath as its own app.
# In the merged app it is a route group at /recording, so no basePath is needed.
NEXT_PUBLIC_BASE_PATH=

# Login. On CNP this app runs the Entra ID login itself (no App Service Easy
# Auth): lib/auth, app/auth, proxy.ts, Caddyfile. "false" leaves everything
# open locally, and the backend uses its mock identity when ENVIRONMENT=local.
AUTH_ENABLED=false

# Needed only when AUTH_ENABLED=true. Deployed environments get these from Key
# Vault (charts/transcribe-web/values.yaml).
# AZURE_AD_TENANT_ID=
# AZURE_AD_CLIENT_ID=
# AZURE_AD_CLIENT_SECRET=
# APP_URL=http://localhost:3000
# Session store. Without it sessions live in process memory, which is refused
# when NODE_ENV=production.
# REDIS_URL=redis://localhost:6379
