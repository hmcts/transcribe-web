# HMCTS Transcribe frontend — local configuration.
# Copy to .env.local for local development. Never commit .env.local.

# Backend base URL. transcribe-api serves both surfaces:
#   /api/*     dictation
#   /api/v1/*  recording
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
BACKEND_INTERNAL_URL=http://127.0.0.1:8000

# Recording area used to be deployed under a /batch basePath as its own app.
# In the merged app it is a route group at /recording, so no basePath is needed.
NEXT_PUBLIC_BASE_PATH=

# Login. On CNP this app runs the Entra ID login itself (no App Service Easy
# Auth): lib/auth, app/auth, proxy.ts, Caddyfile. "false" leaves everything
# open locally, and the backend uses its mock identity when ENVIRONMENT=local.
AUTH_ENABLED=false

# Needed only when AUTH_ENABLED=true. Deployed environments get these from Key
# Vault (charts/transcribe-web/values.yaml).
# AZURE_AD_TENANT_ID=
# AZURE_AD_CLIENT_ID=
# AZURE_AD_CLIENT_SECRET=
# APP_URL=http://localhost:3000
# Session store. Without it sessions live in process memory, which is refused
# when NODE_ENV=production.
# REDIS_URL=redis://localhost:6379

# Live dictation session health (DIAAT-297). The values below are the defaults.
# Seconds of active recording with all three transcript sections still empty
# before the user is explicitly warned that nothing is being captured.
# NEXT_PUBLIC_NO_SPEECH_WARNING_SECONDS=90
# Speech SDK session collapses within the window below that mean the session is
# broken rather than blipping. A working session collapses zero times.
# NEXT_PUBLIC_SPEECH_COLLAPSE_THRESHOLD=3
# NEXT_PUBLIC_SPEECH_COLLAPSE_WINDOW_SECONDS=120

# Live dictation autosave (DIAAT-296). The values below are the defaults.
# Consecutive failed live-draft writes before the judge is told, persistently,
# that their transcript is no longer being saved. Two, not one: the interval
# save runs every 3s and a single dropped request is not worth interrupting
# someone mid-sentence for. An auth failure bypasses this and warns at once,
# because no amount of retrying fixes a rejected sign-in.
# NEXT_PUBLIC_AUTOSAVE_FAILURE_ALERT_THRESHOLD=2
# How many hours into a draft's life the expiry warning starts. The API
# hard-deletes a live draft 24h after its last save (_LIVE_DRAFT_MAX_AGE in
# src/transcribe_api/domain/interface_dictation.py), so 20 gives four hours of warning.
# NEXT_PUBLIC_LIVE_DRAFT_EXPIRY_WARNING_AFTER_HOURS=20
